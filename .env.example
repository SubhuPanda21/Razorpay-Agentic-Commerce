# Set to false and provide real test-mode keys to use the real Razorpay SDK.
USE_MOCK_GATEWAY=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: enables LLM-based catalog query understanding if you extend catalog_service.py
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite:///./agentic_commerce.db

RISK_BLOCK_THRESHOLD=0.75
RISK_HOLD_THRESHOLD=0.45
VELOCITY_WINDOW_MINUTES=10
VELOCITY_MAX_ORDERS=5
RECOVERY_MAX_ATTEMPTS=3
